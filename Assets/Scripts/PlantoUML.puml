@startuml
title MATASANOS GAME - Diagrama UML Completo
!define MONO <<(M,#FFB6C1)>>
!define NETWORK <<(N,#FF8C00)>>
!define INTERFACE <<(I,#87CEEB)>>
!define ABSTRACT <<(A,#FFD700)>>
!define ENUM <<(E,#98FB98)>>

' ============================================================
' ENUMERACIONES (4 enums)
' ============================================================
package "Enums" {
    enum SnapType ENUM {
        Enchufe
        Bateria
        Diente
        Venda
        Jeringuilla
        Bloodbag
    }
    
    enum InyeccionType ENUM {
        Empty
        Calmante
        Estimulante
    }
    
    enum AlienStateEnum ENUM {
        Calmado
        Alterado
        Critico
    }
    
    enum InsectStatesEnum ENUM {
        Wander
        Attack
    }
}

' ============================================================
' INTERFACES (5 interfaces)
' ============================================================
package "Interfaces" {
    interface IEffectable INTERFACE {
        +ApplyEffect(string effectName, float duration)
    }
    
    interface IGrabbable INTERFACE {
        +AddGrabber(ulong clientId, Transform holdPoint)
        +RemoveGrabber(ulong clientId)
        +ulong GetNetworkObjectID()
    }
    
    interface IInteractable INTERFACE {
        +Interact(ulong clientID)
        +ulong GetNetworkObjectID()
    }
    
    interface ISnappable INTERFACE {
        +bool isSnapped
        +SnapZone currentZone
        +SnapTo(SnapZone zone)
        +Unsnap()
    }
}

' ============================================================
' EVENTOS (12 structs de eventos)
' ============================================================
package "Eventos y Bus" {
    class EventBus <<static>> {
        +{static} Subscribe<T>(Action<T> listener)
        +{static} Unsubscribe<T>(Action<T> listener)
        +{static} Publish<T>(T eventItem)
        +{static} Clear()
    }
    
    struct VictoryEvent { }
    struct OnInject {
        ulong VictimID
        InyeccionType Type
    }
    struct OnAlienHealthChanged {
        ulong AlienID
        float CurrentHealth, MaxHealth
    }
    struct OnAlienDeath {
        ulong AlienID
    }
    struct OnAlienParasiteAttack {
        ulong AlienID
    }
    struct OnBloodBagSnapped {
        ulong BloodBagID
    }
    struct OnBloodBagDetached {
        ulong BloodBagID
    }
    struct OnBloodBagEmpty {
        ulong BloodBagID
    }
    struct OnDienteSnap {
        SnappableItem currentItem
    }
    struct TaraHealedEvent {
        ulong TaraID
    }
    struct OnInsectExplosion {
        ulong VictimID
    }
}

' ============================================================
' MÁQUINA DE ESTADOS (FSM)
' ============================================================
package "FSM - State Machine" {
    class StateMachine {
        -State currentState
        +Initialize(State initial)
        +ChangeState(State newState)
        +Update()
    }
    
    abstract class State ABSTRACT {
        #StateMachine stateMachine
        +{abstract} OnEnter()
        +{abstract} OnUpdate()
        +{abstract} OnExit()
    }
    
    ' Estados del Alienígena
    class CalmState NETWORK {
        +OnEnter()
        +OnUpdate()
        +OnExit()
    }
    
    class AlteredState NETWORK {
        +OnEnter()
        +OnUpdate()
        +ParasyteAttack()
        +OnExit()
    }
    
    class CriticalState NETWORK {
        +OnEnter()
        +OnUpdate()
        +OnExit()
    }
    
    ' Estados del Insecto
    class InsectWander NETWORK {
        +OnEnter()
        +OnUpdate()
    }
    
    class InsectAttack NETWORK {
        +OnEnter()
        +OnUpdate()
    }
    
    State <|-- CalmState
    State <|-- AlteredState
    State <|-- CriticalState
    State <|-- InsectWander
    State <|-- InsectAttack
}

' ============================================================
' SISTEMA DE JUGADOR (6 clases)
' ============================================================
package "Player System" {
    class GameManager NETWORK {
        +OnNetworkSpawn()
        +OnNetworkDespawn()
        +DisconnectClient()
        +StartClient()
        +StartHost()
    }
    
    class PlayerInput NETWORK {
        +Vector2 MovementInput
        +Vector2 LookInput
        +event Action OnJumpPressed
        +event Action OnPickUpPressed
        +event Action OnInteractPressed
        +event Action OnSlipPressed
    }
    
    class PlayerController NETWORK {
        -Rigidbody rigidBody
        +OnNetworkSpawn()
        +Move()
        +Jump()
        +IsGrounded()
        +Ragdoll(bool)
    }
    
    class PlayerCamera NETWORK {
        -Transform playerCam
        -Transform holdPoint
        +OnNetworkSpawn()
        +Ragdoll(bool)
        +SetHoldingTool(bool)
    }
    
    class PlayerInteractor NETWORK {
        -IGrabbable currentlyGrabbedItem
        +OnNetworkSpawn()
        +TryGrabOrThrow()
        +TryInteract()
        +Ragdoll(bool)
    }
    
    class PlayerStateManager NETWORK {
        -float stunDuration
        +OnNetworkSpawn()
        +Slip()
        +EnterRagdoll(float, bool)
        +ExitRagdoll()
        +ApplyInyeccion(InyeccionType)
    }
    
    PlayerStateManager ..|> IEffectable
    PlayerController o-- PlayerInput
    PlayerCamera o-- PlayerInput
    PlayerInteractor o-- PlayerInput
    PlayerStateManager --> PlayerController
    PlayerStateManager --> PlayerInteractor
}

' ============================================================
' SISTEMA DE ÍTEMS Y FÍSICA (13 clases)
' ============================================================
package "Items & Physics" {
    class InteractableItem NETWORK {
        +UnityEvent onInteract
        +Interact(ulong clientID)
        +GetNetworkObjectID()
    }
    
    class PhysicalItem NETWORK {
        -Rigidbody rb
        -Dictionary<ulong, Transform> grabbers
        +AddGrabber(ulong, Transform)
        +RemoveGrabber(ulong)
    }
    
    class SnappableItem NETWORK {
        +SnapType itemType
        +bool isSnappable, isUnsnappable
        +bool isSnapped
        +SnapZone currentZone
        +SnapTo(SnapZone)
        +Unsnap()
    }
    
    class ToolItem NETWORK {
        -Transform localHoldPoint
        +AddGrabber(ulong, Transform) override
        +RemoveGrabber(ulong) override
    }
    
    class PoweredItem NETWORK {
        +int energyLoad
        +bool isTurnedOn
        +bool hasPower
        -PowerReceiver ownPlug
        +SetPowered(bool)
        +Interact(ulong)
    }
    
    class Aspiradora NETWORK {
        +Interact(ulong)
    }
    
    class LuzBehaviour NETWORK {
        +Transform originPoint
        +float rayDistance
        +EmitLight()
    }
    
    class InyeccionItem NETWORK {
        +Inject(GameObject victim)
    }
    
    class InyeccionCollider MONO {
        +OnTriggerEnter(Collider)
    }
    
    abstract class TaraBase ABSTRACT {
        #ulong taraID
        +OnNetworkSpawn()
        +MarkAsHealed()
    }
    
    class WoundBehaviour NETWORK {
        +float healingTimeRequired
        +bool isBeingHealed
        +ReceiveHealTick()
    }
    
    class TeethBehaviour NETWORK {
        +OnNetworkSpawn()
        +OnDienteSnapHandler(OnDienteSnap)
    }
    
    class BloodBag NETWORK {
        +float bloodBagCurrentCapacity
        +OnAttach(OnBloodBagSnapped)
        +OnDetach(OnBloodBagDetached)
    }
    
    ' Herencias
    InteractableItem ..|> IInteractable
    PhysicalItem ..|> IGrabbable
    SnappableItem ..|> ISnappable
    InyeccionItem ..|> IInteractable
    
    InteractableItem <|-- PoweredItem
    PoweredItem <|-- Aspiradora
    PhysicalItem <|-- ToolItem
    TaraBase <|-- WoundBehaviour
    TaraBase <|-- TeethBehaviour
    
    ' Referencias
    SnappableItem --> PhysicalItem : "usa"
}

' ============================================================
' SISTEMA DE ENERGÍA Y ACOPLAMIENTO (5 clases)
' ============================================================
package "Power & Snap System" {
    class GeneratorSystem NETWORK {
        +int maxPowerLoad
        +int currentLoad
        +bool isGeneratorOn
        -PowerEmitter[] mainEmitters
        +EvaluateLoad()
        +TurnOnGenerator()
    }
    
    class PowerEmitter NETWORK {
        +bool hasPower
        -PowerReceiver connectedReceiver
        -GeneratorSystem generator
        -PowerReceiver powerProvider
        +OnPlug()
        +OnUnplug()
        +SetEmitting(bool)
        +GetLoad()
    }
    
    class PowerReceiver NETWORK {
        +bool hasPower
        -PowerEmitter[] wiredEmiters
        -PoweredItem toolToPower
        +SetPower(bool, PowerEmitter)
        +GetLoad()
    }
    
    class SnapZone NETWORK {
        +SnapType acceptedType
        +Transform snapAnchor
        +SnappableItem currentItem
        -float cooldown
        +UnityEvent OnObjectSnapped
        +UnityEvent OnObjectUnsnapped
        +OnTriggerEnter(Collider)
        +ReleaseItem()
    }
    
    ' Referencias
    GeneratorSystem o-- PowerEmitter : "[mainEmitters]"
    PowerEmitter o-- PowerReceiver : "[connectedReceiver]"
    PowerEmitter o-- PowerReceiver : "[powerProvider]"
    PowerReceiver o-- PowerEmitter : "[wiredEmiters]"
    PowerReceiver o-- PoweredItem : "[toolToPower]"
    PoweredItem o-- PowerReceiver : "[ownPlug]"
    SnapZone o-- SnappableItem : "[currentItem]"
}

' ============================================================
' SISTEMA DE ALIENÍGENA (7 clases)
' ============================================================
package "Alien System" {
    class AlienStateManager NETWORK {
        -StateMachine stateMachine
        +AlienStateEnum currentActiveState
        +float currentHealth
        +OnNetworkSpawn()
        +TakeDamage(float)
        +NotifyParasiteAttack()
    }
    
    class AlienWoundManager NETWORK {
        +GameObject woundPrefab
        +OnNetworkSpawn()
        +GenerateWound(Vector3, Vector3)
    }
    
    class InsectSpawner NETWORK {
        +OnNetworkSpawn()
        +SpawnInsects(OnAlienParasiteAttack)
    }
    
    class InsectStateMachine NETWORK {
        -StateMachine stateMachine
        +InsectStatesEnum currentActiveState
        +OnNetworkSpawn()
        +AttackPlayer()
        +WanderInsect()
        +CheckPlayer()
    }
    
    ' Referencias
    AlienStateManager o-- BloodBag
    AlienStateManager --> CalmState
    AlienStateManager --> AlteredState
    AlienStateManager --> CriticalState
    InsectStateMachine --> InsectWander
    InsectStateMachine --> InsectAttack
}

' ============================================================
' ENTORNO (3 clases)
' ============================================================
package "Environment" {
    class BloodPuddle NETWORK {
        -float effectDuration
        +OnNetworkSpawn()
        +OnTriggerEnter(Collider)
    }
    
    class PuddleSpawner MONO {
        +{static} Instance
        +GameObject puddlePrefab
        +SpawnPuddleServerRpc(Vector3, float)
    }
    
    BloodPuddle ..|> IEffectable
    PuddleSpawner --> BloodPuddle : "spawnea"
}

' ============================================================
' HERRAMIENTAS Y MECÁNICAS (1 clase)
' ============================================================
package "Tools & Mechanics" {
    class LuzBehaviour NETWORK {
        +Transform originPoint
        +float rayDistance
        +EmitLight()
    }
}

' ============================================================
' UI Y MANAGERS (4 clases)
' ============================================================
package "UI & Managers" {
    class MenuNetwork MONO {
        +Start()
        +OnServerStarted()
    }
    
    class AlienHealthbarUI NETWORK {
        +OnNetworkSpawn()
        +UpdateUI(OnAlienHealthChanged)
        +SetFill(float, float)
    }
    
    class VictoryHandlerUI MONO {
        -GameObject victoryScreen
        +Awake()
        +OnVictory(VictoryEvent)
    }
    
    class WinConditionManager NETWORK {
        +OnNetworkSpawn()
        +OnTaraSpawned(TaraGeneratedEvent)
        +OnTaraHealed(TaraHealedEvent)
        +CheckWinCondition()
    }
}

