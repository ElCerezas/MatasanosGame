        +OnDetach(OnBloodBagDetached e)
        +OnCollisionEnter(Collision)
        -HandleBloodLoss()
        -BloodBagEmpty()
    }
    
    class InsectSpawner NETWORK_BEHAVIOUR {
        +OnNetworkSpawn()
        +OnNetworkDespawn()
        +SpawnInsects(OnAlienParasiteAttack e)
    }
    
    class InsectStateMachine NETWORK_BEHAVIOUR {
        -StateMachine stateMachine
        +NetworkVariable<InsectStatesEnum> currentActiveState
        +OnNetworkSpawn()
        +AttackPlayer()
        +WanderInsect()
        +CheckPlayer()
        -Update()
        -ChangeState(State)
        -NewWanderDirection()
        -OnCollisionEnter(Collision)
    }
    
